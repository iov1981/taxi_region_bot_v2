# ============================================================
# HTML-ПРОВЕРКА
# ============================================================

class TelegramHTMLValidator(HTMLParser):

    ALLOWED_TAGS = {
        "b",
        "strong",
        "i",
        "em",
        "u",
        "ins",
        "s",
        "strike",
        "del",
        "code",
        "pre",
        "a",
        "tg-spoiler",
        "blockquote",
    }

    def __init__(self):
        super().__init__(convert_charrefs=False)
        self.errors = []
        self.open_tags = []

    def handle_starttag(self, tag, attrs):
        tag = tag.lower()

        if tag not in self.ALLOWED_TAGS:
            self.errors.append(
                f"Недопустимый HTML-тег: <{tag}>"
            )
            return

        self.open_tags.append(tag)

    def handle_startendtag(self, tag, attrs):
        tag = tag.lower()

        if tag not in self.ALLOWED_TAGS:
            self.errors.append(
                f"Недопустимый HTML-тег: <{tag}/>"
            )

    def handle_endtag(self, tag):
        tag = tag.lower()

        if tag not in self.ALLOWED_TAGS:
            self.errors.append(
                f"Недопустимый закрывающий тег: </{tag}>"
            )
            return

        if not self.open_tags:
            self.errors.append(
                f"Лишний закрывающий тег: </{tag}>"
            )
            return

        if self.open_tags[-1] != tag:
            self.errors.append(
                "Нарушена вложенность HTML: "
                f"ожидался </{self.open_tags[-1]}>, "
                f"получен </{tag}>"
            )
            return

        self.open_tags.pop()

    def handle_comment(self, data):
        self.errors.append(
            "HTML-комментарии запрещены."
        )


def validate_html(text: str) -> tuple[bool, list[str]]:

    if not isinstance(text, str):
        return False, [
            "Текст сообщения не является строкой."
        ]

    parser = TelegramHTMLValidator()

    try:
        parser.feed(text)
        parser.close()

    except Exception as error:
        parser.errors.append(
            f"Ошибка HTML-парсера: {error}"
        )

    if parser.open_tags:
        parser.errors.append(
            "Не закрыты HTML-теги: "
            + ", ".join(
                f"<{tag}>"
                for tag in parser.open_tags
            )
        )

    return len(parser.errors) == 0, parser.errors


def escape_html(value) -> str:

    if value is None:
        return ""

    return html.escape(
        str(value),
        quote=False
    )


async def send_html_message(bot, chat_id, text, **kwargs):

    valid, errors = validate_html(text)

    if valid:
        return await bot.send_message(
            chat_id,
            text,
            parse_mode="HTML",
            **kwargs
        )

    print()
    print("=" * 60)
    print("❌ ОШИБКА HTML ПЕРЕД ОТПРАВКОЙ")
    print("=" * 60)

    for error in errors:
        print("HTML:", error)

    print()
    print("ТЕКСТ С ОШИБКОЙ:")
    print(text)
    print("=" * 60)

    safe_text = html.escape(
        text,
        quote=False
    )

    return await bot.send_message(
        chat_id,
        safe_text,
        **kwargs
    )


# ============================================================
# СЛУЖЕБНЫЕ СООБЩЕНИЯ
# ============================================================

def is_internal_message(text: str) -> bool:

    if not text:
        return False

    text = text.strip()

    internal_prefixes = (
        "ГЕОКОДИРОВАНИЕ:",
        "GEOAPIFY:",
        "GEOAPIFY ПОИСК",
        "ПОСТРОЕНИЕ МАРШРУТА",
        "ROUTE SERVICE",
    )

    return any(
        text.startswith(prefix)
        for prefix in internal_prefixes
    )


